#!/usr/bin/env bash
export DOTFILES=$HOME/.dotfiles

set -xe

echo "submodules: init"
yadm submodule update --recursive --init

SYSTEM_TYPE=$(uname -s)
HOSTNAME="Kwasi-MBP"

function install:mac() {
    if ! command -v brew >/dev/null 2>&1; then
        /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    fi

    brew update
    brew tap homebrew/bundle
    brew bundle --file "$DOTFILES/Brewfile"
    brew upgrade

    # create directories
    mkdir -p $HOME/.cache
    mkdir -p $HOME/src

    rm -f $HOME/.zshrc
    ln -s $DOTFILES/.zshrc $HOME/.zshrc

    # hide "last login" message
    touch $HOME/.hushlogin
    # configure wallpaper
    m wallpaper "$HOME/Pictures/Wallpaper.png"

    # hide audit and funding messages from npm
    npm config -g set audit false
    npm config -g set fund false

    sudo -v
    # configure hostname
    sudo scutil --set ComputerName "$HOSTNAME"
    sudo scutil --set HostName "$HOSTNAME"
    sudo scutil --set LocalHostName "$HOSTNAME"
    sudo defaults write /Library/Preferences/SystemConfiguration/com.apple.smb.server NetBIOSName -string "$HOSTNAME"

    if [ -f "$DOTFILES/.macOS" ]; then
        source "$DOTFILES/.macOS"
    fi
}

case "$SYSTEM_TYPE" in
    Darwin)
        install:mac
        ;;
    *)
        echo "No bootstrap steps defined for $SYSTEM_TYPE"
        ;;
esac
